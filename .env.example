# ==============================================================================
# PORTFOLIO MONOREPO ENVIRONMENT VARIABLES OVERVIEW
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
SESSION_SECRET=crypto_secure_session_secret_portfolio_2026_change_in_production

# Optional MongoDB Atlas Integration (Defaults to backend/data/db.json if empty)
MONGO_URI=

# Optional Cloudinary CDN Integration (Defaults to backend/uploads/ if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 2. NEXT.JS PUBLIC PORTFOLIO (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://arjun.dev
NEXT_PUBLIC_API_URL=http://localhost:5000/api
BACKEND_URL=http://localhost:5000
ADMIN_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. REACT ADMIN DASHBOARD (admin/.env)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_URL=http://localhost:5000
