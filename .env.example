# Portfolio Environment Configuration Template
# Copy this file to .env or .env.local to configure local development values.
# NEVER commit your actual .env file or sensitive API keys to git.

# Hosted Form Provider Endpoint (e.g. Formspree, Web3Forms, Formsubmit)
# Formspree endpoint format: https://formspree.io/f/YOUR_FORM_ID
# Web3Forms endpoint format: https://api.web3forms.com/submit
VITE_CONTACT_FORM_ENDPOINT=

# Web3Forms Access Key (optional, if using Web3Forms endpoint)
# VITE_WEB3FORMS_ACCESS_KEY=
