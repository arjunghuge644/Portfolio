{
  "name": "portfolio-desktop",
  "version": "1.0.0",
  "description": "Secure Electron Desktop Admin Container for Portfolio Studio",
  "author": "Arjun Ghuge <arjunghuge644@gmail.com>",
  "homepage": "https://arjunghuge.me",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "dev.arjun.portfoliostudio",
    "productName": "Portfolio Studio",
    "electronVersion": "29.4.6",
    "files": [
      "main/**/*",
      "preload/**/*",
      "../admin/dist/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "29.4.6",
    "electron-builder": "^24.13.3"
  }
}
